# Copy to .env for local runs outside Docker. Never commit .env.
# Every variable is validated at start-up; a bad value stops the service with a clear message.
APP_ENV=development
PORT=8080
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT=15s

DATABASE_URL=postgres://disputes:disputes@localhost:5432/disputes?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=1
DB_MAX_CONN_LIFETIME=30m
DB_RUN_MIGRATIONS=true

# Auth
LOGIN_MAX_FAILED_ATTEMPTS=3
SESSION_IDLE_TIMEOUT=15m
SESSION_ABSOLUTE_TIMEOUT=8h
# Defaults to true outside development and cannot be false in production
COOKIE_SECURE=false

# Proxies that append to X-Forwarded-For: 0 locally, 2 on Render (Cloudflare + Render)
TRUSTED_PROXY_HOPS=0

RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_WRITES_PER_HOUR=30

# Core banking (mocked). Raise latency or error rate to demo the timeout and circuit breaker.
CORE_BANKING_TIMEOUT=3s
CORE_BANKING_BREAKER_THRESHOLD=5
CORE_BANKING_BREAKER_OPEN_FOR=30s
MOCK_CORE_BANKING_LATENCY=0s
MOCK_CORE_BANKING_ERROR_RATE=0

# Customer notifications (transactional outbox)
NOTIFY_POLL_INTERVAL=2s
NOTIFY_MAX_ATTEMPTS=8

# Empty disables /metrics. Otherwise at least 32 characters: openssl rand -hex 32
METRICS_TOKEN=

SEED_DEMO_DATA=true
ENABLE_API_DOCS=true
